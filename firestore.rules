rules_version = '2';

// Private data lives under users/{uid} and only its owner can touch it. The
// friends system adds a few narrow, rule-checked holes on top of that:
//   - profiles/{uid} + usernames/{name}: public handle lookup for any signed-in user
//   - users/{uid}/public/*, users/{uid}/activity/*: readable by that user's friends
//   - users/{uid}/friends/{other}: the accepting friend can write their own entry
//   - users/{uid}/notifications/*: friends (and pending requesters) can drop one in
//   - friendRequests/*, challenges/*: shared between the people named in them
// "X's friend" always means X has you in users/X/friends — X controls who sees X.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return request.auth.uid;
    }
    // The streak bot (Vercel cron) is a dedicated Auth user. setup-streak-bot.mjs
    // swaps the placeholder for its real uid; until then it matches nobody.
    function isBot() {
      return request.auth != null && request.auth.uid == 'e5jn3Mt720QOqxWOKrnR1uTc9WD2';
    }
    // `uid` lists the caller as a friend.
    function friendOf(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)/friends/$(me()));
    }
    function hasRequestTo(uid) {
      return exists(/databases/$(database)/documents/friendRequests/$(me() + '_' + uid));
    }
    function dayNumber() {
      return string(int(request.time.toMillis() / 86400000));
    }

    match /users/{userId} {
      allow read, write: if signedIn() && me() == userId;

      match /{document=**} {
        allow read, write: if signedIn() && me() == userId;
      }

      // Stats summary + push subscriptions. The push doc is also readable by
      // someone who has a pending request out to this user, so the request can ping.
      match /public/{docId} {
        allow read: if signedIn() && (friendOf(userId) || (docId == 'push' && (hasRequestTo(userId) || isBot())));
      }

      match /friends/{friendId} {
        allow read: if signedIn() && (me() == friendId || isBot());
        // Accepting userId's request writes yourself into their list.
        allow create: if signedIn() && me() == friendId
          && exists(/databases/$(database)/documents/friendRequests/$(userId + '_' + friendId))
          && request.resource.data.keys().hasOnly(['since'])
          && request.resource.data.since == request.time;
        allow delete: if signedIn() && me() == friendId;
      }

      match /activity/{activityId} {
        allow read: if signedIn() && friendOf(userId);
        // Friends may only set or clear their own reaction.
        allow update: if signedIn() && friendOf(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([me()])
          && (!(me() in request.resource.data.reactions)
            || request.resource.data.reactions[me()] in ['fire', 'strong', 'beast']);
      }

      match /notifications/{nid} {
        // The sender can read what they sent — the push endpoint relies on this.
        allow read: if signedIn() && resource.data.from == me();
        allow create: if signedIn() && (validNotification(userId, nid) || validBotNotification(userId, nid));
      }
    }

    // Streak bot only: at-risk / lost reminders to the user, and "nudge them"
    // pings to the user's friends. One per id, so once per day per target.
    function validBotNotification(to, nid) {
      let d = request.resource.data;
      return isBot()
        && d.from == me()
        && d.keys().hasOnly(['type', 'from', 'fromUsername', 'text', 'ref', 'createdAt', 'read'])
        && d.fromUsername is string && d.fromUsername.size() <= 20
        && d.read == false
        && d.createdAt == request.time
        && (!('text' in d) || (d.text is string && d.text.size() <= 140))
        && (!('ref' in d) || (d.ref is string && d.ref.size() <= 64))
        && (
          (d.type in ['streak_risk', 'streak_lost']
            && nid.matches('^' + d.type + '_' + me() + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          || (d.type == 'friend_streak'
            && d.ref is string
            && nid.matches('^friend_streak_' + me() + '_' + d.ref + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && exists(/databases/$(database)/documents/users/$(d.ref)/friends/$(to))
            && exists(/databases/$(database)/documents/streakWatch/$(d.ref)))
        );
    }

    // Minimal, non-sensitive facts the bot needs to decide on a streak reminder
    // without reading any private workout data.
    match /streakWatch/{uid} {
      allow read: if signedIn() && (me() == uid || isBot());
      allow create, update: if signedIn() && me() == uid && validWatch();
      allow delete: if signedIn() && me() == uid;
    }

    function validWatch() {
      let d = request.resource.data;
      return d.keys().hasOnly(['tz', 'unit', 'current', 'asOfDay', 'lastWorkoutDay', 'restDays', 'weeklyGoal',
          'weekStart', 'workoutsThisWeek', 'prevWeekWorkouts', 'streakBeforePrev', 'updatedAt'])
        && d.tz is string && d.tz.size() <= 64
        && d.unit in ['day', 'week']
        && d.current is int && d.current >= 0 && d.current <= 100000
        && d.asOfDay is string && d.asOfDay.size() == 10
        && d.lastWorkoutDay is string && d.lastWorkoutDay.size() <= 10
        && d.restDays is list && d.restDays.size() <= 14
        && d.weeklyGoal is int && d.weeklyGoal >= 0 && d.weeklyGoal <= 100
        && d.weekStart is string && d.weekStart.size() == 10
        && d.workoutsThisWeek is int && d.workoutsThisWeek >= 0 && d.workoutsThisWeek <= 1000
        && d.prevWeekWorkouts is int && d.prevWeekWorkouts >= 0 && d.prevWeekWorkouts <= 1000
        && d.streakBeforePrev is int && d.streakBeforePrev >= 0 && d.streakBeforePrev <= 100000
        && d.updatedAt is string && d.updatedAt.size() <= 40;
    }

    function validNotification(to, nid) {
      let d = request.resource.data;
      return to != me()
        && d.from == me()
        && d.keys().hasOnly(['type', 'from', 'fromUsername', 'text', 'ref', 'createdAt', 'read'])
        && d.type is string && d.fromUsername is string && d.fromUsername.size() <= 20
        && d.read == false
        && d.createdAt == request.time
        && (!('text' in d) || (d.text is string && d.text.size() <= 140))
        && (!('ref' in d) || (d.ref is string && d.ref.size() <= 64))
        && nid.matches('^' + d.type + '_' + me() + '_[A-Za-z0-9_-]{1,64}$')
        && (
          (d.type == 'friend_request' && hasRequestTo(to))
          // One nudge per friend per (UTC) day: the id is fixed for the day.
          || (d.type == 'nudge' && friendOf(to) && nid == 'nudge_' + me() + '_' + dayNumber())
          || (d.type in ['friend_accept', 'kudos', 'workout', 'challenge_invite', 'challenge_join', 'challenge_left'] && friendOf(to))
        );
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && me() == uid && profileShape()
        && request.resource.data.joinedAt == request.time
        && request.resource.data.usernameChangedAt == request.time
        && request.resource.data.freeChange == true
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow update: if signedIn() && me() == uid && profileShape()
        && request.resource.data.joinedAt == resource.data.joinedAt
        && (sameUsername() || confirmUsername() || validRename(uid));
    }

    function profileShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['username', 'displayName', 'nameKeys', 'joinedAt', 'usernameChangedAt', 'freeChange'])
        && d.username is string && d.username.matches('^[a-z0-9_.]{3,20}$')
        && d.displayName is string && d.displayName.size() <= 40
        && (!('nameKeys' in d) || (d.nameKeys is list && d.nameKeys.size() <= 120))
        && d.freeChange is bool;
    }
    function sameUsername() {
      let d = request.resource.data;
      return d.username == resource.data.username
        && d.usernameChangedAt == resource.data.usernameChangedAt
        && d.freeChange == resource.data.freeChange;
    }
    // Keep the auto-assigned name: spends the free change without renaming, which
    // starts the 30-day cooldown. Can only happen once (freeChange must be true).
    function confirmUsername() {
      let d = request.resource.data;
      return d.username == resource.data.username
        && resource.data.freeChange == true
        && d.freeChange == false
        && d.usernameChangedAt == request.time;
    }
    // One free change after joining, then one every 30 days. The old handle must
    // be released in the same batch so nobody can hoard names.
    function validRename(uid) {
      let d = request.resource.data;
      return d.username != resource.data.username
        && d.usernameChangedAt == request.time
        && d.freeChange == false
        && (resource.data.freeChange == true
          || request.time > resource.data.usernameChangedAt + duration.value(30, 'd'))
        && getAfter(/databases/$(database)/documents/usernames/$(d.username)).data.uid == uid
        && !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username));
    }

    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me()
        && getAfter(/databases/$(database)/documents/profiles/$(me())).data.username == name;
      allow delete: if signedIn() && resource.data.uid == me()
        && getAfter(/databases/$(database)/documents/profiles/$(me())).data.username != name;
    }

    match /friendRequests/{rid} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn()
        && request.resource.data.from == me()
        && request.resource.data.to != me()
        && rid == me() + '_' + request.resource.data.to
        && request.resource.data.keys().hasOnly(['from', 'to', 'createdAt', 'fromUsername', 'fromName', 'toUsername', 'toName'])
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.to));
      allow delete: if signedIn() && (resource.data.from == me() || resource.data.to == me());
    }

    match /challenges/{cid} {
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn() && validChallenge();
      // Members can join, decline (or leave: decline after accepting) and post their own score — nothing else.
      allow update: if signedIn() && me() in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scores', 'accepted', 'declined'])
        && request.resource.data.scores.diff(resource.data.scores).affectedKeys().hasOnly([me()])
        && (!(me() in request.resource.data.scores) || request.resource.data.scores[me()] is number)
        && onlyAddsMe(request.resource.data.accepted, resource.data.accepted)
        && onlyAddsMe(request.resource.data.declined, resource.data.declined);
      allow delete: if signedIn() && resource.data.creator == me();

      // Photo-verified battles: one proof per workout, posted by its owner,
      // visible to every member. Proofs are never edited, only deleted.
      match /proofs/{pid} {
        allow read: if signedIn()
          && me() in get(/databases/$(database)/documents/challenges/$(cid)).data.members;
        allow create: if signedIn() && validProof(cid, pid);
        allow delete: if signedIn() && resource.data.uid == me();
      }
    }

    function validProof(cid, pid) {
      let d = request.resource.data;
      let c = get(/databases/$(database)/documents/challenges/$(cid)).data;
      return d.keys().hasOnly(['uid', 'workoutId', 'day', 'workoutName', 'value', 'svg', 'w', 'h', 'caption', 'createdAt'])
        && d.uid == me()
        && me() in c.accepted
        && c.get('verify', 'none') == 'photo'
        && d.workoutId is string && d.workoutId.size() >= 1 && d.workoutId.size() <= 64
        && pid == me() + '_' + d.workoutId
        && d.day is string && d.day >= c.startDay && d.day <= c.endDay
        && d.workoutName is string && d.workoutName.size() <= 80
        && d.value is number
        && d.svg is string && d.svg.size() <= 60000 && d.svg.matches('<svg .*')
        && d.w is int && d.h is int && d.w > 0 && d.h > 0 && d.w <= 400 && d.h <= 400
        && (!('caption' in d) || (d.caption is string && d.caption.size() <= 140))
        && d.createdAt == request.time;
    }

    // Public plan library: anyone signed in can browse; authors edit their own.
    // `starred`/`starOrder` (recommended plans) are set only from the Firebase
    // console — clients can never write them.
    match /publicPlans/{pid} {
      allow read: if signedIn();
      allow create: if signedIn() && validPublicPlan()
        && request.resource.data.authorUid == me()
        && !('starred' in request.resource.data)
        && !('starOrder' in request.resource.data)
        && request.resource.data.usedBy == {}
        && request.resource.data.createdAt == request.time
        // The built-in Push/Pull/Legs plan belongs to @ClaytonHax.
        && (pid != 'ppl-8day' || me() == 't2MZUOISXMcg4fZuoX5ZeqgTK2x2');
      allow update: if signedIn() && (
        (resource.data.authorUid == me() && validPublicPlan()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'tagline', 'days', 'updatedAt']))
        // Anyone may mark (or unmark) that they use it — only their own entry.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
          && request.resource.data.usedBy.diff(resource.data.usedBy).affectedKeys().hasOnly([me()])
          && (!(me() in request.resource.data.usedBy) || request.resource.data.usedBy[me()] == true))
      );
      allow delete: if signedIn() && resource.data.authorUid == me();
    }

    function validPublicPlan() {
      let d = request.resource.data;
      return d.keys().hasOnly(['authorUid', 'name', 'description', 'tagline', 'days', 'createdAt', 'updatedAt', 'usedBy', 'starred', 'starOrder'])
        && d.authorUid is string
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && (!('description' in d) || (d.description is string && d.description.size() <= 500))
        && (!('tagline' in d) || (d.tagline is string && d.tagline.size() <= 80))
        && d.days is list && d.days.size() >= 1 && d.days.size() <= 14
        && d.usedBy is map
        && d.updatedAt == request.time;
    }

    function onlyAddsMe(next, prev) {
      return next is list && next.hasAll(prev) && next.toSet().difference(prev.toSet()).hasOnly([me()]);
    }
    function memberIsFriend(members, i) {
      return members.size() <= i || exists(/databases/$(database)/documents/users/$(members[i])/friends/$(me()));
    }
    function validChallenge() {
      let d = request.resource.data;
      return d.keys().hasOnly(['creator', 'members', 'accepted', 'declined', 'metric', 'title', 'startDay', 'endDay', 'createdAt', 'scores', 'verify'])
        && (!('verify' in d) || d.verify in ['none', 'photo'])
        && d.creator == me()
        && d.members is list && d.members.size() >= 2 && d.members.size() <= 5
        && d.members[0] == me()
        && d.members.toSet().size() == d.members.size()
        && d.accepted == [me()]
        && d.declined == []
        && d.metric in ['workouts', 'days', 'volume', 'sets', 'minutes']
        && d.title is string && d.title.size() <= 60
        && d.startDay is string && d.endDay is string
        && d.createdAt == request.time
        && d.scores.keys().hasOnly([me()])
        && memberIsFriend(d.members, 1)
        && memberIsFriend(d.members, 2)
        && memberIsFriend(d.members, 3)
        && memberIsFriend(d.members, 4);
    }
  }
}
